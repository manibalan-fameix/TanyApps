{
  "name": "showmoto-car-dealer",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "db:seed-restaurant": "node --env-file-if-exists=.env.local scripts/seed-restaurant.ts",
    "db:import-variants": "node --env-file-if-exists=.env.local scripts/import-variants.ts",
    "test:e2e": "playwright test",
    "worker": "node --env-file-if-exists=.env.local workers/index.ts",
    "deploy:tracker": "wrangler deploy -c workers/tracker/wrangler.jsonc",
    "deploy": "pnpm deploy:tracker && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@base-ui/react": "^1.8.0",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.10",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@shadcn/react": "^0.3.1",
    "@types/canvas-confetti": "^1.9.0",
    "ag-charts-community": "^14.2.0",
    "ag-charts-react": "^14.2.0",
    "ag-grid-community": "36.0.2",
    "ag-grid-react": "36.0.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "input-otp": "^1.5.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "motion": "^13.4.4",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.2",
    "pg-cloudflare": "^1.4.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.66.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  }
}
