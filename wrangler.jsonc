{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanyapps",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "ROOT_DOMAIN": "tany.in",
    "CLOUDFLARE_ZONE_ID": "aa82f4018aed83289d6805c42dc02e3e",
    "AUTH_TRUST_HOST": "true",
    "FIREBASE_API_KEY": "AIzaSyDwdZSWGytJA4jgaefwFK05woapq84MTdI",
    "FIREBASE_AUTH_DOMAIN": "tany-6c638.firebaseapp.com",
    "FIREBASE_PROJECT_ID": "tany-6c638",
    "FIREBASE_APP_ID": "1:582955315597:web:6c70cfd8b1f84bf4ef8dc4",
    "R2_ACCOUNT_ID": "8b98f4164cf5f4c0400f25a3f66b2ede",
    "R2_BUCKET": "tany",
    "R2_PUBLIC_URL": "https://cdn.tany.in",
    "RC_PROVIDER": "mock",
    // Where phones open the live-location WebSocket. The ticket is signed with the TRACKER_SECRET secret, shared with the tracker.
    "TRACKER_WS_URL": "wss://track.tany.in/ws"
  },
  // Per-listing views, shared-link clicks and chats, read back by the dashboard through the Analytics Engine SQL API.
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "tany_listing_events" },
    // Operational counters (webhook fallback hits, rate-limiter failures). See lib/core/metrics.ts.
    { "binding": "METRICS", "dataset": "tany_platform_metrics" }
  ],
  // Each delivery's latest rider position lives in a Durable Object defined by workers/tracker. Deploy that worker first
  // (`pnpm deploy:tracker`, which `pnpm run deploy` does for you), then this one.
  "durable_objects": {
    "bindings": [
      { "name": "TRACKER", "class_name": "OrderTracker", "script_name": "tanyapps-tracker" },
      // Shared rate limiter, hosted by the same worker (lib/core/rate-limit.ts). Deploy the tracker first.
      { "name": "RATE_LIMITER", "class_name": "RateLimiter", "script_name": "tanyapps-tracker" }
    ]
  },
  // Production hostnames. `custom_domain` makes Cloudflare create the DNS record and certificate (the tany.in zone must be active
  // on this account, with no existing record on these names). Dealer showrooms (<slug>.tany.in) are served by the wildcard route,
  // which needs one proxied wildcard DNS record: bash scripts/setup-wildcard-dns.sh
  "routes": [
    { "pattern": "tany.in", "custom_domain": true },
    { "pattern": "app.tany.in", "custom_domain": true },
    { "pattern": "*.tany.in/*", "zone_name": "tany.in" }
  ],
  "observability": { "enabled": true },

  // STAGING: the same code on its own domain (tanystaging.in, a separate Cloudflare zone), database, buckets, secrets and Razorpay test
  // keys. Deploy with `pnpm deploy:staging` (docs/tanycabs/STAGING.md). Wrangler does not inherit vars, routes or bindings into an
  // environment, so each is repeated here. ROOT_DOMAIN is the only thing that makes it "staging": the code has no staging special case.
  "env": {
    "staging": {
      "name": "tanyapps-staging",
      "vars": {
        "ROOT_DOMAIN": "tanystaging.in",
        // CLOUDFLARE_ZONE_ID (the tanystaging.in zone) is a secret on staging: see .env.staging in STAGING.md.
        "AUTH_TRUST_HOST": "true",
        // The same Firebase project as production unless you create a separate one (STAGING.md). The web keys are public values.
        "FIREBASE_API_KEY": "AIzaSyDwdZSWGytJA4jgaefwFK05woapq84MTdI",
        "FIREBASE_AUTH_DOMAIN": "tany-6c638.firebaseapp.com",
        "FIREBASE_PROJECT_ID": "tany-6c638",
        "FIREBASE_APP_ID": "1:582955315597:web:6c70cfd8b1f84bf4ef8dc4",
        "R2_ACCOUNT_ID": "8b98f4164cf5f4c0400f25a3f66b2ede",
        "R2_BUCKET": "tany-staging",
        "R2_PUBLIC_URL": "https://cdn.tanystaging.in",
        "RC_PROVIDER": "mock",
        "TRACKER_WS_URL": "wss://track.tanystaging.in/ws"
      },
      "analytics_engine_datasets": [
        { "binding": "ANALYTICS", "dataset": "tany_listing_events_staging" },
        { "binding": "METRICS", "dataset": "tany_platform_metrics_staging" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "TRACKER", "class_name": "OrderTracker", "script_name": "tanyapps-tracker-staging" },
          { "name": "RATE_LIMITER", "class_name": "RateLimiter", "script_name": "tanyapps-tracker-staging" }
        ]
      },
      // tanystaging.in is its own zone, so the free Universal certificate (apex + one level of wildcard) covers every host here.
      "routes": [
        { "pattern": "tanystaging.in", "custom_domain": true },
        { "pattern": "app.tanystaging.in", "custom_domain": true },
        { "pattern": "*.tanystaging.in/*", "zone_name": "tanystaging.in" }
      ]
    }
  }
}
