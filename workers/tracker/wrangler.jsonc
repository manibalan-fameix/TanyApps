{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Holds each delivery's latest rider position. Deployed on its own so the app can bind to it by name.
  "name": "tanyapps-tracker",
  "main": "index.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  // Phones connect here for live positions: wss://track.tany.in/ws?t=<ticket>. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "track.tany.in", "custom_domain": true }],
  // Pages on this domain (and its subdomains) may open a connection. Set the secret with:
  //   pnpm exec wrangler secret put TRACKER_SECRET -c workers/tracker/wrangler.jsonc
  // and give the main app the very same value (see wrangler.jsonc).
  "vars": { "ALLOWED_ROOT": "tany.in" },
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "TRACKER", "class_name": "OrderTracker" },
      // The shared rate limiter (lib/core/rate-limit.ts).
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  // SQLite-backed objects: available on every Cloudflare plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OrderTracker"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] }
  ],
  "observability": { "enabled": true },

  // STAGING (docs/tanycabs/STAGING.md): its own worker, hostname and objects, so staging positions and rate limits never touch production.
  "env": {
    "staging": {
      "name": "tanyapps-tracker-staging",
      "routes": [{ "pattern": "track.staging.tany.in", "custom_domain": true }],
      "vars": { "ALLOWED_ROOT": "staging.tany.in" },
      "durable_objects": {
        "bindings": [
          { "name": "TRACKER", "class_name": "OrderTracker" },
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["OrderTracker"] },
        { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] }
      ]
    }
  }
}
