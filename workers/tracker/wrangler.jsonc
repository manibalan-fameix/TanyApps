{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Holds each delivery's latest rider position. Deployed on its own so the app can bind to it by name.
  "name": "showmoto-tracker",
  "main": "index.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  // Phones connect here for live positions: wss://track.showmoto.in/ws?t=<ticket>. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "track.showmoto.in", "custom_domain": true }],
  // Pages on this domain (and its subdomains) may open a connection. Set the secret with:
  //   pnpm exec wrangler secret put TRACKER_SECRET -c workers/tracker/wrangler.jsonc
  // and give the main app the very same value (see wrangler.jsonc).
  "vars": { "ALLOWED_ROOT": "showmoto.in" },
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "TRACKER", "class_name": "OrderTracker" }] },
  // SQLite-backed objects: available on every Cloudflare plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrderTracker"] }],
  "observability": { "enabled": true }
}
