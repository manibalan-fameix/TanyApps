{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Fires the schedules and calls the app's internal cron route. Holds no state; the app keeps the lock per (job, slot).
  "name": "tanyapps-cron",
  "main": "index.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  // Cron expressions are UTC. Keep in step with SCHEDULE in index.ts.
  "triggers": { "crons": ["* * * * *", "*/5 * * * *", "30 2 * * *", "30 0 1 * *"] },
  // Where the app lives (the app host, the only host that serves /api/internal). The secret is set with:
  //   pnpm exec wrangler secret put CRON_SECRET -c workers/cron/wrangler.jsonc
  "vars": { "CRON_TARGET_URL": "https://app.tany.in" },
  "observability": { "enabled": true },

  // STAGING (docs/tanycabs/STAGING.md): its own worker, calling the staging app. Its own secret: pnpm deploy:staging / upload-secrets.sh set it.
  "env": {
    "staging": {
      "name": "tanyapps-cron-staging",
      "triggers": { "crons": ["* * * * *", "*/5 * * * *", "30 2 * * *", "30 0 1 * *"] },
      "vars": { "CRON_TARGET_URL": "https://app.staging.tany.in" }
    }
  }
}
