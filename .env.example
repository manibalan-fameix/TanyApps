# Copy to .env.local and fill in. Never commit real values.

# --- Core (Phase 1) ---
# Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/tanyapps
# Domain dealers' sites live under, without protocol. Dev: localhost:3000
# Dealer sites: <slug>.ROOT_DOMAIN, admin: app.ROOT_DOMAIN
ROOT_DOMAIN=localhost:3000
# Optional: Google Maps JavaScript API key (restrict it to your domains). When set, every map uses Google; otherwise OpenStreetMap.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Optional: the domain used in links sent to riders and guests (WhatsApp). Set to your live domain to send real links from a local admin.
# SHARE_ROOT_DOMAIN=tany.in
# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=
# Firebase Authentication (Google, phone OTP, email + password). These are the PUBLIC web-app values from
# Firebase console > Project settings > Your apps > Web app. They are safe to expose; nothing secret here.
# Also enable the providers under Authentication > Sign-in method and add your domains under Settings > Authorized domains.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Optional. Defaults to <project-id>.firebaseapp.com.
FIREBASE_AUTH_DOMAIN=
# Development only. 10-digit numbers you added under Authentication > Phone > Phone numbers for testing.
# For these, reCAPTCHA and SMS are skipped locally. Never used in production.
FIREBASE_TEST_PHONES=
# 32 bytes, base64. Encrypts reg numbers, phones, RC responses. `openssl rand -base64 32`
# Losing this key makes encrypted data unreadable. Back it up separately from the database.
ENCRYPTION_KEY=

# 32 bytes, base64. Keyed hash (HMAC) used to look up encrypted values such as phone numbers without decrypting them
# (lib/crypto/blind-index.ts). `openssl rand -base64 32`. Losing or changing it breaks those lookups, so back it up like
# ENCRYPTION_KEY, and never reuse that key's value.
BLIND_INDEX_KEY=

# --- Seed only ---
# Makes this Google account the owner of the first demo dealer.
SEED_OWNER_EMAIL=

# --- Tany super admin ---
# Comma-separated emails of the Tany team allowed into /super. Anyone else gets a 404.
SUPER_ADMIN_EMAILS=

# --- Add-a-car flow (Phase 2-3) ---
# Media storage on Cloudflare R2. All five must be set together.
# Leave them empty in development: uploads then go to ./.local-uploads instead.
# In production, missing R2 keys are an error, never a silent fallback.
# R2_PUBLIC_URL must be a custom domain on a Cloudflare zone with Image Resizing enabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# RC (vehicle registration) lookups: "mock" (default, fake data, never shows the RTO badge) or "surepass".
RC_PROVIDER=mock
RC_API_KEY=
# Optional override of the provider's base URL.
RC_BASE_URL=

# Google Gemini API key (https://aistudio.google.com/apikey). Powers plate reading, variant tie-breaks, captions, the video angle check,
# and the buyer-facing chat widget (general + per-car).
# Empty = all of those fall back to manual entry / rules / a template caption; chat stays hidden.
VISION_API_KEY=
# Optional. Defaults to gemini-3.6-flash. A smaller model is cheaper and faster for plate reading.
VISION_MODEL=
# Optional. Model for the buyer-facing chat widget. Defaults to VISION_MODEL, then gemini-3.6-flash.
CHAT_MODEL=

# Optional. Cloud Run service that exposes POST /generate and owns Vertex AI authentication.
# When set, buyer chat uses this before VISION_API_KEY. It may return text/plain or text/event-stream.
CLOUD_RUN_GENERATE_URL=
# Optional bearer token if the Cloud Run endpoint is protected by an application-level token.
# Do not put a Google service-account private key in this app's environment.
CLOUD_RUN_AUTH_TOKEN=

# --- Later phases (not used yet) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
RESEND_API_KEY=
SENTRY_DSN=

# Cloudflare: each new dealer's <slug>.ROOT_DOMAIN is attached to the Worker as a Custom Domain.
# Token needs Workers Scripts: Edit and Zone > DNS: Edit. Zone ID is on the zone Overview page.
# CLOUDFLARE_ACCOUNT_ID falls back to R2_ACCOUNT_ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Razorpay subscriptions (test keys start rzp_test_). Set the same two as Worker secrets in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook: Dashboard > Settings > Webhooks > URL https://app.<ROOT_DOMAIN>/api/webhooks/razorpay, subscription.* events.
RAZORPAY_WEBHOOK_SECRET=


# Test keys only: lets food orders be paid online before a restaurant has connected a bank account.
# The money stays in your Razorpay TEST balance. Ignored for live keys. Leave empty in production.
RAZORPAY_ALLOW_DIRECT=

# --- Background jobs (cron) ---
# Shared secret between the cron worker (workers/cron) and the app's /api/internal/cron/* route, sent in the x-cron-secret
# header. `openssl rand -base64 32`. Set the same value on both: Worker secret CRON_SECRET for the app and for tanyapps-cron.
CRON_SECRET=

# --- Rate limiter and metrics (Cloudflare bindings, nothing to set here) ---
# RATE_LIMITER (Durable Object hosted by the tanyapps-tracker worker) and METRICS (Analytics Engine) are bound in wrangler.jsonc.
# Without them, local development falls back to an in-memory limiter and plain console logging.

# Which maps service to use for place search and addresses. Only "nominatim" (OpenStreetMap, light use only) exists today.
# GEO_PROVIDER=

# --- TanyCabs: place search and distances ---
# SERVER key for Google Places API (New) and Routes API. Create it in Google Cloud and restrict it to those two APIs (Cloudflare
# Workers have no fixed IP, so restrict by API, not by address). It is only ever read on the server: the browser calls our own
# server actions and never sees it. Do NOT give it a NEXT_PUBLIC_ name. Not the same as NEXT_PUBLIC_GOOGLE_MAPS_KEY above, which
# is a browser key for showing maps.
# Without it, development falls back to OpenStreetMap (Nominatim + OSRM); production has no place search until it is set.
GOOGLE_MAPS_SERVER_KEY=
# 1 asks Routes for toll prices. Off by default: Google's toll docs do not say India is covered and toll requests cost more.
GOOGLE_ROUTES_TOLLS=
# Days to keep a Google road distance in route_distances (0-30). Default 0 = do not store: Google's Routes API policy says
# caching of most Routes content is restricted. Set it only after confirming your use is allowed.
GOOGLE_ROUTE_CACHE_DAYS=

# --- TanyCabs: who can create a cab business ---
# Comma-separated verified emails allowed to choose TanyCabs in onboarding. Empty = nobody (it stays a "coming soon" card).
CABS_ALLOWED_EMAILS=
